project:
  name: "{{project.name}}"
  description: "{{project.description}}"
  type: {{project.type}}           # greenfield | brownfield | coordination
  repo_role: {{repo_role}}         # code | coordination — see the multi-repo coordination model
  team_size: {{team.size}}         # solo | small | enterprise
  initialized_at: {{today}}
  forgekit_version: "1.6"          # must match forge-init.md's own frontmatter version

# [INCLUDE ONLY IF repo_role: code AND an existing coordination repo was named during
#  Phase 2b — omit this key entirely for "not yet"; never write an empty string or null]
coordination_repo: "{{coordination_repo}}"   # org/repo — the dedicated coordination repo this
                                              # project participates in; set by /forge-init's
                                              # Phase 2b or reactively by /promote-to-thread

# [INCLUDE ONLY IF repo_role: coordination — both optional and additive, no dedicated
#  authoring command; hand-edit directly. See sdlc/promotions/README.md.]
known_participants:
  - repo: "{{participant.repo}}"              # org/repo
    purpose: "{{participant.purpose}}"
environments:
  - name: "{{environment.name}}"              # [a-z0-9-] only
    purpose: "{{environment.purpose}}"
    governance: {{environment.governance}}    # ci | promotion | release
# [END INCLUDE]

# How SDLC artifacts are stored and provided to pipeline commands.
# markdown    — all artifacts are .md files in this repo; commands read/write directly
# hybrid      — SPEC, BUG, and INC live in an external tool (paste in / copy out);
#               all technical artifacts (DESIGN, PLAN, TEST-PLAN, etc.) remain as .md files
# copy-paste  — all artifacts live in an external tool; commands prompt to paste in
#               and output content to copy back for every artifact type
artifact_mode: {{artifact_mode}}

# [INCLUDE ONLY IF artifact_mode: copy-paste OR hybrid]
external_tool:
  name: "{{external_tool.name}}"
  artifact_map:
    spec: "{{artifact_map.spec}}"
    bug: "{{artifact_map.bug}}"
    incident: "{{artifact_map.incident}}"
# [END INCLUDE]

# [INCLUDE ONLY IF repo_role: code — a coordination repo has no stack and no compliance
#  surface of its own; omit this entire block for repo_role: coordination rather than
#  filling it with placeholders]
stack:
  language: {{stack.language}}
  framework: {{stack.framework}}
  database: {{stack.database}}
  migration_tool: {{stack.migration_tool}}
  lint: "{{stack.lint}}"           # lint + type check command, or "none"
  test:
    unit: "{{stack.test.unit}}"
    e2e: "{{stack.test.e2e}}"      # or "none" if no e2e runner
  deploy:
    command: "{{stack.deploy.command}}"
    env_pull: "{{stack.deploy.env_pull}}"
    migration_command: "{{stack.deploy.migration_command}}"
  ci: {{stack.ci}}
  ci_trigger_command: "{{stack.ci_trigger_command}}"   # runnable command execute-tests uses to trigger
                                                         # this repo's CI (e.g. "gh workflow run test.yml",
                                                         # a Jenkins CLI invocation) — or "none" to always
                                                         # run tests locally instead of triggering CI
  qa_trigger_command: "{{stack.qa_trigger_command}}"   # only meaningful when pipeline.test_gate: post_merge —
                                                         # runnable command execute-tests uses to validate the
                                                         # already-merged/deployed state; "none" falls back to
                                                         # running stack.test.unit/stack.test.e2e locally against
                                                         # main's current (freshly synced) checkout instead
  observability: {{stack.observability}}
  auth: {{stack.auth}}
  llm_agent_framework: {{stack.llm_agent_framework}}   # or "none"
  llm_agent_untrusted_input: {{stack.llm_agent_untrusted_input}}  # yes | no | n/a (n/a if framework is "none")

compliance:
  frameworks: {{compliance.frameworks}}   # e.g. [pci_dss], [hipaa], [soc2, gdpr], or [none]
  pci_scope: {{compliance.pci_scope}}     # n/a | delegated | partial | full — only meaningful if pci_dss is in frameworks
  notes: "{{compliance.notes}}"           # free text — anything not captured by the fixed framework list
# [END INCLUDE]

pipeline:
  security_review: conditional   # conditional = triggered on auth/secrets changes; always | never also valid
  observability: true
  postmortem: SEV-2              # severity threshold: postmortem required for incidents at this level or higher
                                 # SEV-1 | SEV-2 | SEV-3 | SEV-4 | always | never
  evidence_mode: repo_only       # repo_only | hybrid
  test_gate: pre_merge           # pre_merge | post_merge — pre_merge is today's only behavior: /execute-tests
                                 # must pass against the feature branch before /create-pr can merge it. post_merge
                                 # merges a reviewed milestone to main immediately and tests the merged/deployed
                                 # state afterward — for a team whose real QA environment only ever deploys from
                                 # main. Trade-off: main (and whatever QA deploys from it) can briefly carry code
                                 # that hasn't yet been confirmed to pass. Absent or malformed → treated as
                                 # pre_merge (fail-closed, same convention as the operator.allow.* defaults above).

# Autonomy policy for /operate (DESIGN-0001 §4, ADR-0003). Every allow.* key defaults to
# false — absence of this entire block, or absence of a specific key within it, both mean
# "false," never implicitly "true." require_human.* keys are shown for legibility only;
# /operate always enforces both true regardless of what is written here or whether this
# block exists at all — a project cannot configure around Safety Invariants #11/#20.
operator:
  max_review_rounds: 3
  max_actions_per_run: 25
  allow:
    create_artifacts: false
    revise_artifacts: false
    implement_code: false
    run_tests: false
    create_pr: false
    nonproduction_promotion: false
  require_human:
    risk_acceptance: true        # always enforced true regardless of this value
    production_release: true     # always enforced true regardless of this value
